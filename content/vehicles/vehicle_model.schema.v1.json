{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tranzit.vehicle-model-family.v1",
  "title": "Tranzit vehicle model family v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "display_name",
    "real_prototype",
    "introduction_year",
    "date_precision",
    "manufacturer_id",
    "mode",
    "vehicle_kind",
    "roles",
    "platform",
    "support_family_id",
    "production",
    "regional_market_profile_id",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "real_prototype": {
      "type": "string",
      "minLength": 1
    },
    "introduction_year": {
      "type": "integer",
      "minimum": 1800,
      "maximum": 2100
    },
    "introduction_source_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "date_precision": {
      "enum": [
        "day",
        "month",
        "year"
      ]
    },
    "manufacturer_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "rail",
        "road"
      ]
    },
    "vehicle_kind": {
      "enum": [
        "locomotive",
        "railcar",
        "multiple_unit",
        "passenger_coach",
        "service_coach",
        "freight_wagon",
        "truck",
        "bus",
        "horse_freight",
        "horse_bus"
      ]
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "platform": {
      "type": "object",
      "required": [
        "empty_mass_t",
        "max_speed_kph"
      ],
      "properties": {
        "length_m": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "width_m": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "height_m": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "empty_mass_t": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "service_mass_t": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_speed_kph": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "structural_speed_limit_kph": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "payload_t": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cargo_volume_m3": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "seats": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "standing": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "berths": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "power_kw": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "starting_tractive_effort_kn": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "axle_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "axle_load_t": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "minimum_curve_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "gauge_mm": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fuel_energy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "support_family_id": {
      "type": "string"
    },
    "production": {
      "type": "object",
      "required": [
        "source_kind",
        "factory_ids",
        "series_build_days",
        "special_build_days",
        "base_cost_index"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "active_map",
            "off_map",
            "local_builder",
            "mixed"
          ]
        },
        "factory_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series_build_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "special_build_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "base_cost_index": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "initial_capability_state": {
          "enum": [
            "prototype_pre_series",
            "series_production",
            "low_rate_special_order",
            "parts_and_overhaul_only",
            "external_specialist_support_only",
            "used_market_only"
          ]
        }
      }
    },
    "regional_market_profile_id": {
      "type": "string"
    },
    "maintenance_profile": {
      "type": "object"
    },
    "consumption_profile": {
      "type": "object"
    },
    "equipment_group_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "built_in_template_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_urls",
        "notes"
      ],
      "properties": {
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
